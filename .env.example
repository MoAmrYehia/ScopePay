# Copy to .env (never commit it) or set these in your host's dashboard.
# Every integration is optional: without keys ScopePay runs in a labelled demo mode.

# --- AI (set one) ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_PROVIDER=openai          # openai | anthropic (auto-detected from the key)
# AI_MODEL=gpt-4.1-mini        # vision-capable model; defaults per provider
# AI_DAILY_LIMIT=300           # spend guard for public demos

# --- PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same sandbox app, subscribed to INVOICING.INVOICE.PAID,
# INVOICING.INVOICE.UPDATED and INVOICING.INVOICE.CANCELLED, pointing at
# https://<your-host>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
# Sandbox personal (buyer) account: prefilled as the client email so you can pay invoices.
PAYPAL_SANDBOX_BUYER_EMAIL=
# Optional: must be your sandbox business account email if set.
# PAYPAL_INVOICER_EMAIL=
# INVOICER_BUSINESS_NAME=Jamie Lee Studio

# --- Server ---
# PORT=3000
# DATA_DIR=data
# PUBLIC_URL=https://scopepay.onrender.com   # used in client links inside PayPal invoices
